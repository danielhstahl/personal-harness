{
  "name": "pi-beads-loop",
  "version": "0.1.0",
  "description": "Hyper-opinionated agent loop with pi",
  "keywords": [
    "pi",
    "harness",
    "beads",
    "agent"
  ],
  "license": "ISC",
  "author": "Daniel Stahl",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "pi-beads-loop": "./dist/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "spike:idle": "node spikes/4-idle-pty.ts",
    "spike:split": "node spikes/5-split-live.ts",
    "spike:render": "node spikes/7-render-live.ts",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
