#!/usr/bin/env node
/**
 * Fake `bd` used by `test/beads.test.ts`.
 *
 * It is deliberately dumb: the scenario is chosen with `FAKE_BD_SCENARIO`, and
 * every invocation is appended as one JSON line to `FAKE_BD_RECORD` so tests can
 * assert the exact argv and environment the adapter produced — not just its
 * return value.
 *
 * Shapes mirror real `bd 1.3.0 --json` output captured during ADR-001/the
 * adapter spike: `create` returns a single object, `list`/`ready`/`show`/
 * `update`/`close` return arrays, `recall` returns {found,key,value}.
 */
import fs from "node:fs";

const record = process.env.FAKE_BD_RECORD;
const scenario = process.env.FAKE_BD_SCENARIO ?? "issues";
const argv = process.argv.slice(2);

if (record) {
  fs.appendFileSync(
    record,
    JSON.stringify({
      scenario,
      argv,
      bdLastTouchedFallback:
        process.env.BD_LAST_TOUCHED_FALLBACK === undefined
          ? null
          : process.env.BD_LAST_TOUCHED_FALLBACK,
      shell: process.env.FAKE_BD_SHELL ?? null,
    }) + "\n",
  );
}

const out = (text) => process.stdout.write(text);
const err = (text) => process.stderr.write(text);

const issue = (id, title, status) => ({
  id,
  title,
  description: `desc for ${id}`,
  acceptance_criteria: `ac for ${id}`,
  status,
  priority: 1,
  issue_type: "task",
  owner: "tester",
  created_at: "2026-09-19T14:00:00Z",
  updated_at: "2026-09-19T14:00:00Z",
  labels: ["loop"],
  dependency_count: 0,
  dependent_count: 0,
  comment_count: 0,
});

switch (scenario) {
  case "issues":
    out(JSON.stringify([issue("fake-1", "ready one", "open"), issue("fake-2", "ready two", "open")]));
    process.exit(0);
    break;

  case "empty":
    out("[]");
    process.exit(0);
    break;

  case "create":
    out(
      JSON.stringify({
        id: "fake-new1",
        title: argv[argv.indexOf("--title") + 1] ?? "",
        description: argv.includes("--description") ? argv[argv.indexOf("--description") + 1] : "",
        acceptance_criteria: argv.includes("--acceptance") ? argv[argv.indexOf("--acceptance") + 1] : "",
        status: "open",
        priority: Number(argv.includes("--priority") ? argv[argv.indexOf("--priority") + 1] : 2),
        issue_type: argv.includes("--type") ? argv[argv.indexOf("--type") + 1] : "task",
        labels: ["loop"],
        schema_version: 1,
      }),
    );
    process.exit(0);
    break;

  case "dep":
    out(
      JSON.stringify([
        { issue_id: argv[2], depends_on_id: argv[3], status: "added", type: "blocks", schema_version: 1 },
      ]),
    );
    process.exit(0);
    break;

  case "updated":
    out(JSON.stringify([issue("fake-1", "ready one", "in_progress")]));
    process.exit(0);
    break;

  case "closed":
    out(JSON.stringify([issue("fake-1", "ready one", "closed")]));
    process.exit(0);
    break;

  case "remembered":
    out(
      JSON.stringify({
        action: "remembered",
        key: argv.includes("--key") ? argv[argv.indexOf("--key") + 1] : "auto-slug",
        value: argv[1],
        schema_version: 1,
      }),
    );
    process.exit(0);
    break;

  case "recall-found":
    out(JSON.stringify({ found: true, key: argv[1], value: "remembered handoff text", schema_version: 1 }));
    process.exit(0);
    break;

  // Real bd: not-found is exit 1 but a well-formed JSON answer on stdout.
  case "recall-missing":
    out(JSON.stringify({ found: false, key: argv[1], value: "", schema_version: 1 }));
    process.exit(1);
    break;

  case "show-not-found":
    out(
      JSON.stringify({
        error: "no issues found matching the provided IDs",
        hint: "some IDs may reference deleted/purged records",
      }),
    );
    err("Issue fake-gone not found\n");
    process.exit(1);
    break;

  case "exit1":
    err("Error: general failure, nothing was written\n");
    process.exit(1);
    break;

  case "guard13":
    err('Error updating fake-1: status mismatch: fake-1 has status "in_progress", expected "closed"\n');
    err('{"error":"1 of 1 issues failed to update","failed":[{"id":"fake-1","guard_mismatch":true}]}\n');
    process.exit(13);
    break;

  case "nonjson":
    out("this is definitely not JSON {{{\n");
    process.exit(0);
    break;

  case "empty-output":
    process.exit(0);
    break;

  case "slow": {
    const shared = new SharedArrayBuffer(4);
    Atomics.wait(new Int32Array(shared), 0, 0, 5000);
    out("[]");
    process.exit(0);
    break;
  }

  // `bd list` / `bd ready` report dependencies as EDGES.
  case "list-deps":
    out(
      JSON.stringify([
        {
          ...issue("fake-child", "child", "open"),
          dependencies: [
            {
              issue_id: "fake-child",
              depends_on_id: "fake-blocker",
              type: "blocks",
              created_at: "2026-09-19T14:00:00Z",
              created_by: "tester",
              metadata: "{}",
            },
          ],
          dependency_count: 1,
        },
      ]),
    );
    process.exit(0);
    break;

  // `bd show` reports the same relationship as the INLINED OTHER ISSUE with
  // `dependency_type` — captured verbatim from bd 1.3.0 (shape differs on purpose).
  case "show-deps":
    out(
      JSON.stringify([
        {
          ...issue("fake-child", "child", "open"),
          dependencies: [
            {
              ...issue("fake-blocker", "the blocker", "in_progress"),
              dependency_type: "blocks",
            },
          ],
          dependency_count: 1,
        },
      ]),
    );
    process.exit(0);
    break;

  default:
    err(`fake bd: unknown scenario "${scenario}"\n`);
    process.exit(64);
}
