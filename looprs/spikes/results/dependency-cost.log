#   ./spikes/dep_cost.sh before
#   ./spikes/dep_cost.sh default-no-notify
#   ./spikes/dep_cost.sh notify-on --features notify
#
#   # the dependency surface, both halves of the tree
#   ./scripts/dep_audit.py            # the table
#   ./scripts/dep_audit.py --gate     # what ./scripts/check.sh runs
#   ./scripts/dep_audit.py --features # plus the resolved feature surface per crate
#
#   # the gate in both feature configurations
#   ./scripts/check.sh
