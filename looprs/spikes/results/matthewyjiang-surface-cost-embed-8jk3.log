   blast3.drop_run.child_still_ours	true
   	The Run's Drop cancels the token and aborts the worker task. Aborting is
   	not awaiting: the tool future is dropped where it stands, so a blocking
   	spawn is not unwound and its child outlives the run.
   blast4.sigkill_holder.holder_pid	237361
   blast4.sigkill_holder.tool_child_pid	Some(237371)
   blast4.sigkill_holder.holder_reaped	true
